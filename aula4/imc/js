function dividir() {
    var n1 = parseFloat(document.getElementById("peso").value);
    var n2 = parseFloat(document.getElementById("altura").value);
    var n3 = n2 * n2;
    var n4 = n1/n3;

    if (n4<18.5) {
        document.getElementById("imc").innerText = 
        "Seu Imc é : "+ n4+" Você está magro";
    }
    else if (n4>= 18.5 && n4<=24.9) {
        document.getElementById("imc").innerText = 
        "Seu Imc é : "+ n4+" Você está normal";
    }
   else if (n4>= 25 && n4<=29.9) {
        document.getElementById("imc").innerText = 
        "Seu Imc é : "+ n4+"Você está com sobrepeso";
    }
   else if (n4>= 30 && n4<=39.9) {
        document.getElementById("imc").innerText = 
        "Seu Imc é : "+ n4+" Você está obeso";
    } else {
        document.getElementById("imc").innerText = 
        "Seu Imc é : "+ n4+" Você está estremamente obeso";
    }   
}
